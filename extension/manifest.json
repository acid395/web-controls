{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "web-controls (proof of concept)",
  "version": "1.36.0",
  "description": "Ask a water or weather site a question in plain English. Reads the page you're on, drives its controls, or answers from public USGS, NOAA and NWS data. No account, no API key.",
  "permissions": [
    "activeTab",
    "tabs",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://waterdata.usgs.gov/*",
    "https://dashboard.waterdata.usgs.gov/*",
    "https://mywaterway.epa.gov/*",
    "https://www.drought.gov/*",
    "https://water.noaa.gov/*",
    "https://*.weather.gov/*",
    "https://waterservices.usgs.gov/*",
    "https://api.water.noaa.gov/*",
    "https://api.weather.gov/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "web-controls - ask about this page"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open web-controls"
    }
  }
}
